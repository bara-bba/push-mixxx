<!--
  pusher.midi.xml  –  Ableton Push 2 deck mapping for Mixxx
  Script file: pusher-script.js   (functionprefix: PUSH2T)

  MIDI convention: Traktor C-1=0  →  C2=36=0x24 (Push 2 bottom-left pad)
  Status 0x90 = Note On Ch1 (pads)   |   Status 0xB0 = CC Ch1 (encoders/buttons)
  Push 2 LED animations: 0x90=static, 0x9A=blinking (Ch11), all via JS

  ┌────────────────────────────────────────────────────────────┐
  │ GRID  col→  1      2      3    [4=VU]  5      6      7   [8=VU]
  │ row↓
  │  8    G#6   A6    A#6   [B6]   C7    C#7    D7   [D#7]
  │       BL-   BEAT  BL+   VUA   BL-   BEAT   BL+   VUB
  │  7    C6   C#6    D6   [D#6]   E6    F6    F#6   [G6]
  │       BJB  BGRID  BJF   VUA   BJB  BGRID   BJF   VUB
  │  6    E5    F5   F#5   [G5]   G#5   A5    A#5   [B5]
  │       L-IN  ...  L-OUT  VUA  L-IN   ...  L-OUT   VUB
  │  5    G#4   A4   A#4   [B4]   C5   C#5    D5   [D#5]
  │       HC1   HC2  HC3    VUA   HC1   HC2   HC3    VUB
  │  4    C4   C#4    D4   [D#4]   E4    F4   F#4   [G4]
  │       HC4   HC5  HC6    VUA   HC4   HC5   HC6    VUB
  │  3    E3    F3   F#3   [G3]   G#3   A3   A#3   [B3]
  │       SHFT  ...   ...   VUA   ...   ...   ...    VUB
  │  2    G#2   A2   A#2   [B2]   C3   C#3    D3   [D#3]
  │       SLP  KEY   QNT   VUA   SLP  KEY    QNT    VUB
  │  1    C2   C#2    D2   [D#2]   E2    F2   F#2   [G2]
  │       PLY  CUP   SYN   VUA   PLY  CUP   SYN    VUB
  │             ← DECK A (Ch1) →         ← DECK B (Ch2) →
  └────────────────────────────────────────────────────────────┘
-->

<MixxxControllerPreset schemaVersion="1" mixxxVersion="">
    <info>
        <name>Push 2 (Pusher)</name>
        <author>Converted from Traktor TSI</author>
        <description>Full deck mapping for Ableton Push 2. Deck A = Ch1 (left half), Deck B = Ch2 (right half). VU meters on columns 4 and 8. Requires pusher-script.js.</description>
    </info>

    <controller id="Ableton Push 2">
        <scriptfiles>
            <file functionprefix="PUSH2T" filename="pusher-script.js"/>
        </scriptfiles>

        <controls>


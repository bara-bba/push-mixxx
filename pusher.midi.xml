            <control><group></group><key>PUSH2T.loadNextB</key>
                <description>Load next track in list to Deck B – CC26 (0x1A)</description>
                <status>0xB0</status><midino>0x1A</midino>
                <options><script-binding/></options></control>

            <!-- ══════════════════════════════════════════════════════════
                 CC – BROWSE ENCODER + LIBRARY
                 ══════════════════════════════════════════════════════════ -->

            <control><group></group><key>PUSH2T.browseEncoder</key>
                <description>Browse encoder – CC14 (0x0E). Normal: scroll tracks (MoveVertical). With SHIFT held: navigate library sidebar sections (MoveFocusForward/Backward).</description>
                <status>0xB0</status><midino>0x0E</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.toggleBrowser</key>
                <description>Toggle browser panel – CC85 (0x55) Play button on Push2</description>
                <status>0xB0</status><midino>0x55</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.recordToggle</key>
                <description>Record toggle – CC86 (0x56) Record button on Push2</description>
                <status>0xB0</status><midino>0x56</midino>
                <options><script-binding/></options></control>

            <!-- ══════════════════════════════════════════════════════════
                 CC – TOP ENCODERS
                 Encoders 1 & 5 act as JOG wheels (scratch when touched,
                 pitch-bend when not). Their capacitive touch sends Note On
                 (0x90) / Note Off (0x80): encoder 1 = note 0x00 (Deck A),
                 encoder 5 = note 0x04 (Deck B).
                 Encoders 4 & 8 stay as gain.
                 Relative rotation: 1..63 fwd, 65..127 back.
                 ══════════════════════════════════════════════════════════ -->

            <!-- Jog touch detection (capacitive) -->
            <control><group></group><key>PUSH2T.jogTouchA</key>
                <description>Jog A touch ON – encoder 1 (note 0x00)</description>
                <status>0x90</status><midino>0x00</midino>
                <options><script-binding/></options></control>
            <control><group></group><key>PUSH2T.jogTouchA</key>
                <description>Jog A touch OFF – encoder 1 (note 0x00)</description>
                <status>0x80</status><midino>0x00</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.jogTouchB</key>
                <description>Jog B touch ON – encoder 5 (note 0x04)</description>
                <status>0x90</status><midino>0x04</midino>
                <options><script-binding/></options></control>
            <control><group></group><key>PUSH2T.jogTouchB</key>
                <description>Jog B touch OFF – encoder 5 (note 0x04)</description>
                <status>0x80</status><midino>0x04</midino>
                <options><script-binding/></options></control>

            <!-- Jog rotation -->
            <control><group></group><key>PUSH2T.rateA</key>
                <description>Jog Deck A – CC71 (0x47) encoder 1 (scratch/pitch-bend)</description>
                <status>0xB0</status><midino>0x47</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.gainA</key>
                <description>Gain/Pre-gain Deck A – CC74 (0x4A) encoder 4</description>
                <status>0xB0</status><midino>0x4A</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.rateB</key>
                <description>Jog Deck B – CC75 (0x4B) encoder 5 (scratch/pitch-bend)</description>
                <status>0xB0</status><midino>0x4B</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.gainB</key>
                <description>Gain/Pre-gain Deck B – CC78 (0x4E) encoder 8</description>
                <status>0xB0</status><midino>0x4E</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.masterVol</key>
                <description>Master Volume – CC79 (0x4F) master encoder</description>
                <status>0xB0</status><midino>0x4F</midino>
                <options><script-binding/></options></control>

            <!-- ══════════════════════════════════════════════════════════
                 CC – GAIN RESET (upper display buttons 4 and 8)
                 ══════════════════════════════════════════════════════════ -->

            <control><group></group><key>PUSH2T.gainResetA</key>
                <description>Gain Reset Deck A – CC105 (0x69) display btn 4</description>
                <status>0xB0</status><midino>0x69</midino>
                <options><script-binding/></options></control>

            <control><group></group><key>PUSH2T.gainResetB</key>
                <description>Gain Reset Deck B – CC109 (0x6D) display btn 8</description>
                <status>0xB0</status><midino>0x6D</midino>
                <options><script-binding/></options></control>

        </controls>
        <!-- All LED outputs are driven by engine.makeConnection() in pusher-script.js -->
        <outputs/>
    </controller>
</MixxxControllerPreset>